digraph ARCH {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.4, ranksep=0.9, pad=0.3, dpi=150, labelloc=t, label="DevMatch - System Architecture"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef2ff", color="#6366f1"];
  edge  [fontname="Helvetica", fontsize=10];

  browser [label="Browser\n(contributor / maintainer / admin)", fillcolor="#fef9c3", color="#ca8a04"];
  subgraph cluster_next {
    label="Next.js 16 app (Node)"; style="rounded,dashed"; color="#6366f1"; fontname="Helvetica";
    pages  [label="Pages (React Server Components)\n/login /dashboard /maintainer/* /admin"];
    api    [label="Route Handlers (/api/...)\nauth, match, search,\nmaintainer/*, admin/stats"];
    auth   [label="lib/auth.ts\nJWT cookie + role check", fillcolor="#dcfce7", color="#16a34a"];
    emb    [label="lib/embeddings.ts\ntext -> 768-dim vector", fillcolor="#dcfce7", color="#16a34a"];
    pool   [label="lib/db.ts\npg connection pool", fillcolor="#dcfce7", color="#16a34a"];
  }
  gemini [label="Gemini Embedding API\ngemini-embedding-001", fillcolor="#fce7f3", color="#db2777"];
  subgraph cluster_db {
    label="PostgreSQL 16 + pgvector (Docker)"; style="rounded,dashed"; color="#0f766e"; fontname="Helvetica";
    tables [label="Tables\nusers, contributors, skills,\nrepositories, issues, applications ...", fillcolor="#ccfbf1", color="#0f766e"];
    logic  [label="Triggers / functions\ntrg_issue_status_log\nmatch_issues()", fillcolor="#ccfbf1", color="#0f766e"];
    views  [label="Views\nv_open_issues, v_skill_demand,\nv_repo_stats", fillcolor="#ccfbf1", color="#0f766e"];
    idx    [label="Indexes\nHNSW (cosine), GIN (full text)", fillcolor="#ccfbf1", color="#0f766e"];
  }

  browser -> pages [label="HTTP"];
  browser -> api   [label="fetch JSON"];
  pages -> pool; api -> auth; api -> emb; api -> pool; pages -> auth;
  emb -> gemini [label="HTTPS"];
  pool -> tables [label="parameterised SQL"];
  tables -> logic; tables -> views; tables -> idx;
}
