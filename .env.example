# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=devmatch
POSTGRES_PASSWORD=change_me
POSTGRES_DB=devmatch
DATABASE_URL=postgres://devmatch:change_me@localhost:5432/devmatch
# Optional: the app server signs in as the limited role dm_app (created by db/14_app_role.sql).
# Remove this line to make the app use DATABASE_URL (the owner) instead.
APP_DATABASE_URL=postgres://dm_app:app_pass_123@localhost:5432/devmatch

# Embedding provider (hosted API) - used later for issue/profile embeddings
EMBEDDING_API_KEY=
EMBEDDING_DIM=768

# Auth
JWT_SECRET=change_me_long_random_string
